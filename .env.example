# Copy to .env (never commit .env). All values have demo-safe defaults.

# Demo: simulated clock, synthetic patients, on-screen demo phone. Set false in production.
DEMO_MODE=true
DEMO_SPEED=10
# Start the demo day at: morning (8:15 AM), early (7:00 AM, closed), late (4:20 PM), after (5:05 PM, closed)
DEMO_START_AT=morning

# Text a one-time code before a web join completes (closes the "already in line" privacy leak).
JOIN_ONE_TIME_CODE=true

# Required in production.
SECRET_KEY=change-me-to-a-long-random-string
PHONE_ENCRYPTION_KEY=
STAFF_PIN=2468
DATABASE_URL=sqlite:///./clinic_queue.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/clinic_queue

# Twilio (leave blank to use the demo phone).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
