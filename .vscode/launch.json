{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Clinic queue: run demo server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "env": { "DEMO_MODE": "true" },
      "justMyCode": true
    },
    {
      "name": "Clinic queue: run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "justMyCode": false
    }
  ]
}
